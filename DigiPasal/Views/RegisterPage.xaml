<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DigiPasal.ViewModels"
             x:Class="DigiPasal.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Create Account"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ====== FORM CARD ====== -->
            <Border BackgroundColor="{StaticResource CardBackground}"
                    StrokeThickness="0"
                    Margin="16,16,16,0"
                    Padding="20,24">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="12" Opacity="0.08"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">

                    <!-- Subheader -->
                    <Label Text="Create Account"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,18"/>

                    <!-- Error Message -->
                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           TextColor="{StaticResource ErrorRed}"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,14"/>

                    <!-- Owner Name -->
                    <Label Text="Owner Name"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}"
                           Margin="0,0,0,6"/>
                    <Border Stroke="{StaticResource InputStroke}" StrokeThickness="1"
                            BackgroundColor="{StaticResource InputBg}"
                            HeightRequest="46">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Entry Text="{Binding FullName}"
                               Placeholder="e.g., Ram Bahadur"
                               PlaceholderColor="{StaticResource Gray400}"
                               Keyboard="Plain"
                               ReturnType="Next"
                               IsEnabled="{Binding IsNotBusy}"
                               BackgroundColor="Transparent"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="14"
                               Margin="12,0"/>
                    </Border>

                    <!-- Shop Name -->
                    <Label Text="Shop Name"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}"
                           Margin="0,14,0,6"/>
                    <Border Stroke="{StaticResource InputStroke}" StrokeThickness="1"
                            BackgroundColor="{StaticResource InputBg}"
                            HeightRequest="46">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Entry Text="{Binding ShopName}"
                               Placeholder="e.g., Ram Pasal"
                               PlaceholderColor="{StaticResource Gray400}"
                               Keyboard="Plain"
                               ReturnType="Next"
                               IsEnabled="{Binding IsNotBusy}"
                               BackgroundColor="Transparent"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="14"
                               Margin="12,0"/>
                    </Border>

                    <!-- Username -->
                    <Label Text="Username"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}"
                           Margin="0,14,0,6"/>
                    <Border Stroke="{StaticResource InputStroke}" StrokeThickness="1"
                            BackgroundColor="{StaticResource InputBg}"
                            HeightRequest="46">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Entry Text="{Binding Username}"
                               Placeholder="e.g., ramkp"
                               PlaceholderColor="{StaticResource Gray400}"
                               Keyboard="Plain"
                               ReturnType="Next"
                               IsEnabled="{Binding IsNotBusy}"
                               BackgroundColor="Transparent"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="14"
                               Margin="12,0"/>
                    </Border>

                    <!-- Password -->
                    <Label Text="Password"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}"
                           Margin="0,14,0,6"/>
                    <Border Stroke="{StaticResource InputStroke}" StrokeThickness="1"
                            BackgroundColor="{StaticResource InputBg}"
                            HeightRequest="46">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Grid.Column="0"
                                   Text="{Binding Password}"
                                   IsPassword="{Binding IsPasswordHidden}"
                                   Placeholder="Min 8 characters"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   Keyboard="Plain"
                                   ReturnType="Next"
                                   IsEnabled="{Binding IsNotBusy}"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="14"
                                   Margin="12,0,0,0"/>
                            <Button Grid.Column="1"
                                    Text="{Binding PasswordVisibilityLabel}"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource TealPrimary}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    Padding="10,0"/>
                        </Grid>
                    </Border>

                    <!-- Confirm Password -->
                    <Label Text="Confirm Password"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}"
                           Margin="0,14,0,6"/>
                    <Border Stroke="{StaticResource InputStroke}" StrokeThickness="1"
                            BackgroundColor="{StaticResource InputBg}"
                            HeightRequest="46">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Grid.Column="0"
                                   Text="{Binding ConfirmPassword}"
                                   IsPassword="{Binding IsPasswordHidden}"
                                   Placeholder="Re-enter password"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   Keyboard="Plain"
                                   ReturnType="Done"
                                   IsEnabled="{Binding IsNotBusy}"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="14"
                                   Margin="12,0,0,0"/>
                            <Button Grid.Column="1"
                                    Text="{Binding PasswordVisibilityLabel}"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource TealPrimary}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    Padding="10,0"/>
                        </Grid>
                    </Border>

                    <!-- Device Lock Note -->
                    <Label Margin="0,12,0,0"
                           FontSize="11"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalTextAlignment="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="A device lock screen (PIN/Pattern/Password) is required for verification."/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <!-- Register Button -->
                    <Button Text="Register"
                            Command="{Binding RegisterCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="{StaticResource TealPrimary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="16"
                            HeightRequest="50"
                            CornerRadius="10"
                            Margin="0,14,0,0"/>

                    <!-- Login Footer -->
                    <Label Margin="0,18,0,0"
                           FontSize="14"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Already have an account? "
                                      TextColor="{StaticResource TextSecondary}"/>
                                <Span Text="Login"
                                      TextColor="{StaticResource TealPrimary}"
                                      FontAttributes="Bold"/>
                            </FormattedString>
                        </Label.FormattedText>
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToLoginCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
