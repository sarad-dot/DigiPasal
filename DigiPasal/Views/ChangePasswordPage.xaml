<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DigiPasal.ViewModels"
             x:Class="DigiPasal.Views.ChangePasswordPage"
             x:DataType="vm:ChangePasswordViewModel"
             Title="Change Password"
             BackgroundColor="{StaticResource AppBackground}"
             Shell.TabBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ====== BRANDED HEADER ====== -->
            <Grid BackgroundColor="{StaticResource TealPrimary}"
                  Padding="24,20,24,22"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="14">

                <Border Grid.Column="0"
                        BackgroundColor="#FFFFFF20"
                        StrokeThickness="0"
                        WidthRequest="52" HeightRequest="52"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Label Text="🏪" FontSize="26"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="DigiPasal"
                           FontSize="24" FontAttributes="Bold"
                           TextColor="White"/>
                    <Label Text="Nepal Retail Management"
                           FontSize="13"
                           TextColor="#CCFFFFFF"/>
                </VerticalStackLayout>
            </Grid>

            <!-- ====== FORM CARD ====== -->
            <Border BackgroundColor="{StaticResource CardBackground}"
                    StrokeThickness="0"
                    Margin="16,16,16,0"
                    Padding="20,24">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="12" Opacity="0.08"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">

                    <!-- Subheader -->
                    <Label Text="Update your password"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,18"/>

                    <!-- Error Message -->
                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           TextColor="{StaticResource ErrorRed}"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,14"/>

                    <!-- Current Password -->
                    <Label Text="Current Password"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}"
                           Margin="0,0,0,6"/>
                    <Border Stroke="{StaticResource InputStroke}" StrokeThickness="1"
                            BackgroundColor="{StaticResource InputBg}"
                            HeightRequest="46">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Grid.Column="0"
                                   Text="{Binding CurrentPassword}"
                                   IsPassword="{Binding IsCurrentPasswordHidden}"
                                   Placeholder="Enter current password"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   Keyboard="Plain"
                                   ReturnType="Next"
                                   IsEnabled="{Binding IsNotBusy}"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="14"
                                   Margin="12,0,0,0"/>
                            <Button Grid.Column="1"
                                    Text="{Binding CurrentPasswordVisibilityLabel}"
                                    Command="{Binding ToggleCurrentPasswordVisibilityCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource TealPrimary}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    Padding="10,0"/>
                        </Grid>
                    </Border>

                    <!-- New Password -->
                    <Label Text="New Password"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}"
                           Margin="0,14,0,6"/>
                    <Border Stroke="{StaticResource InputStroke}" StrokeThickness="1"
                            BackgroundColor="{StaticResource InputBg}"
                            HeightRequest="46">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Grid.Column="0"
                                   Text="{Binding NewPassword}"
                                   IsPassword="{Binding IsNewPasswordHidden}"
                                   Placeholder="Min 8 characters"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   Keyboard="Plain"
                                   ReturnType="Next"
                                   IsEnabled="{Binding IsNotBusy}"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="14"
                                   Margin="12,0,0,0"/>
                            <Button Grid.Column="1"
                                    Text="{Binding NewPasswordVisibilityLabel}"
                                    Command="{Binding ToggleNewPasswordVisibilityCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource TealPrimary}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    Padding="10,0"/>
                        </Grid>
                    </Border>

                    <!-- Confirm New Password -->
                    <Label Text="Confirm New Password"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}"
                           Margin="0,14,0,6"/>
                    <Border Stroke="{StaticResource InputStroke}" StrokeThickness="1"
                            BackgroundColor="{StaticResource InputBg}"
                            HeightRequest="46">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Grid.Column="0"
                                   Text="{Binding ConfirmPassword}"
                                   IsPassword="{Binding IsNewPasswordHidden}"
                                   Placeholder="Re-enter new password"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   Keyboard="Plain"
                                   ReturnType="Done"
                                   IsEnabled="{Binding IsNotBusy}"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="14"
                                   Margin="12,0,0,0"/>
                            <Button Grid.Column="1"
                                    Text="{Binding NewPasswordVisibilityLabel}"
                                    Command="{Binding ToggleNewPasswordVisibilityCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource TealPrimary}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    Padding="10,0"/>
                        </Grid>
                    </Border>

                    <!-- Change Password Button -->
                    <Button Text="Change Password"
                            Command="{Binding ChangePasswordCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            BackgroundColor="{StaticResource TealPrimary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="16"
                            HeightRequest="50"
                            CornerRadius="10"
                            Margin="0,18,0,0"/>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>