<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DigiPasal.ViewModels"
             x:Class="DigiPasal.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Profile"
             BackgroundColor="{StaticResource AppBackground}"
             Shell.TabBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ====== BRANDED HEADER ====== -->
            <Grid BackgroundColor="{StaticResource TealPrimary}"
                  Padding="24,20,24,22"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="14">

                <Border Grid.Column="0"
                        BackgroundColor="#FFFFFF20"
                        StrokeThickness="0"
                        WidthRequest="52" HeightRequest="52"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Label Text="🏪" FontSize="26"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="DigiPasal"
                           FontSize="24" FontAttributes="Bold"
                           TextColor="White"/>
                    <Label Text="Nepal Retail Management"
                           FontSize="13"
                           TextColor="#CCFFFFFF"/>
                </VerticalStackLayout>
            </Grid>

            <!-- ====== PROFILE CARD ====== -->
            <Border BackgroundColor="{StaticResource CardBackground}"
                    StrokeThickness="0"
                    Margin="16,16,16,0"
                    Padding="20,24">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="12" Opacity="0.08"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">

                    <!-- Avatar -->
                    <Border BackgroundColor="{StaticResource TealPrimary}"
                            StrokeThickness="0"
                            WidthRequest="76" HeightRequest="76"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="38"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding Initials}"
                               FontSize="26" FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <Label Text="{Binding FullName}"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center"
                           Margin="0,14,0,0"/>

                    <Label Text="{Binding Username}"
                           FontSize="13"
                           TextColor="{StaticResource TealPrimary}"
                           HorizontalOptions="Center"
                           Margin="0,2,0,0"/>

                    <Label Text="{Binding ShopName}"
                           FontSize="14"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalOptions="Center"
                           Margin="0,8,0,0"/>

                    <Label Margin="0,6,0,0"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Member since "/>
                                <Span Text="{Binding MemberSince}"
                                      TextColor="{StaticResource TextPrimary}"
                                      FontAttributes="Bold"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <BoxView HeightRequest="1" Color="{StaticResource DividerColor}"
                             Margin="0,20,0,0"/>

                    <!-- Error Message -->
                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           TextColor="{StaticResource ErrorRed}"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           Margin="0,14,0,0"/>

                    <!-- ====== EDIT MODE ====== -->
                    <VerticalStackLayout Spacing="0" IsVisible="{Binding IsEditing}">

                        <Label Text="Full Name"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}"
                               Margin="0,14,0,6"/>
                        <Border Stroke="{StaticResource InputStroke}" StrokeThickness="1"
                                BackgroundColor="{StaticResource InputBg}"
                                HeightRequest="46">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Entry Text="{Binding EditFullName}"
                                   Placeholder="Full name"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   Keyboard="Plain"
                                   ReturnType="Next"
                                   IsEnabled="{Binding IsNotBusy}"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="14"
                                   Margin="12,0"/>
                        </Border>

                        <Label Text="Shop Name"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}"
                               Margin="0,14,0,6"/>
                        <Border Stroke="{StaticResource InputStroke}" StrokeThickness="1"
                                BackgroundColor="{StaticResource InputBg}"
                                HeightRequest="46">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Entry Text="{Binding EditShopName}"
                                   Placeholder="Shop name"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   Keyboard="Plain"
                                   ReturnType="Done"
                                   IsEnabled="{Binding IsNotBusy}"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="14"
                                   Margin="12,0"/>
                        </Border>

                        <Button Text="Save Changes"
                                Command="{Binding SaveEditCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                BackgroundColor="{StaticResource TealPrimary}"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="16"
                                HeightRequest="50"
                                CornerRadius="10"
                                Margin="0,18,0,0"/>

                        <Button Text="Cancel"
                                Command="{Binding CancelEditCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource TextSecondary}"
                                FontSize="15"
                                HeightRequest="46"
                                CornerRadius="10"
                                Margin="0,8,0,0"/>
                    </VerticalStackLayout>

                    <!-- ====== VIEW MODE ====== -->
                    <VerticalStackLayout Spacing="0" IsVisible="{Binding IsNotEditing}">

                        <Button Text="✏️  Edit Profile"
                                Command="{Binding BeginEditCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                BackgroundColor="{StaticResource InputBg}"
                                TextColor="{StaticResource TealPrimary}"
                                FontSize="15" FontAttributes="Bold"
                                HeightRequest="48"
                                CornerRadius="10"
                                BorderColor="{StaticResource InputStroke}"
                                BorderWidth="1"
                                Margin="0,16,0,0"/>

                        <Button Text="🔑  Change Password"
                                Command="{Binding ChangePasswordCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                BackgroundColor="{StaticResource TealPrimary}"
                                TextColor="White"
                                FontSize="15" FontAttributes="Bold"
                                HeightRequest="48"
                                CornerRadius="10"
                                Margin="0,12,0,0"/>

                        <Button Text="🚪  Logout"
                                Command="{Binding LogoutCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                BackgroundColor="{StaticResource CardBackground}"
                                TextColor="{StaticResource DangerRed}"
                                FontSize="15" FontAttributes="Bold"
                                HeightRequest="48"
                                CornerRadius="10"
                                BorderColor="{StaticResource DangerRed}"
                                BorderWidth="1"
                                Margin="0,12,0,0"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Label Text="DigiPasal v1.2, © 2026"
                   FontSize="12"
                   TextColor="{StaticResource Gray300}"
                   HorizontalOptions="Center"
                   Margin="0,20,0,30"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>