<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DigiPasal.ViewModels"
             x:Class="DigiPasal.Views.ForgetPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Title="Reset Password"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ====== FORM CARD ====== -->
            <Border BackgroundColor="{StaticResource CardBackground}"
                    StrokeThickness="0"
                    Margin="16,16,16,0"
                    Padding="20,24">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="12" Opacity="0.08"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">

                    <!-- Subheader -->
                    <Label Text="Reset Password"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,18"/>

                    <!-- Error Message -->
                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           TextColor="{StaticResource ErrorRed}"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           Margin="0,0,0,14"/>

                    <!-- ====== STAGE 1: VERIFY IDENTITY ====== -->
                    <VerticalStackLayout Spacing="0" IsVisible="{Binding IsNotVerified}">

                        <Label Text="Username"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}"
                               Margin="0,0,0,6"/>
                        <Border Stroke="{StaticResource InputStroke}" StrokeThickness="1"
                                BackgroundColor="{StaticResource InputBg}"
                                HeightRequest="48">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Entry Text="{Binding Username}"
                                   Placeholder="Enter your username"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   Keyboard="Plain"
                                   ReturnType="Done"
                                   IsEnabled="{Binding IsNotBusy}"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="14"
                                   Margin="12,0"/>
                        </Border>

                        <Label Margin="0,12,0,0"
                               FontSize="11"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Verify with your device lock screen to proceed."/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Button Text="Verify Identity"
                                Command="{Binding VerifyCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                BackgroundColor="{StaticResource TealPrimary}"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="16"
                                HeightRequest="50"
                                CornerRadius="10"
                                Margin="0,18,0,0"/>
                    </VerticalStackLayout>

                    <!-- ====== STAGE 2: SET NEW PASSWORD ====== -->
                    <VerticalStackLayout Spacing="0" IsVisible="{Binding IsVerified}">

                        <Label Text="New Password"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}"
                               Margin="0,0,0,6"/>
                        <Border Stroke="{StaticResource InputStroke}" StrokeThickness="1"
                                BackgroundColor="{StaticResource InputBg}"
                                HeightRequest="48">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Entry Text="{Binding NewPassword}"
                                   IsPassword="True"
                                   Placeholder="Min 8 characters"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   Keyboard="Plain"
                                   ReturnType="Next"
                                   IsEnabled="{Binding IsNotBusy}"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="14"
                                   Margin="12,0"/>
                        </Border>

                        <Label Text="Confirm New Password"
                               FontSize="13" FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}"
                               Margin="0,14,0,6"/>
                        <Border Stroke="{StaticResource InputStroke}" StrokeThickness="1"
                                BackgroundColor="{StaticResource InputBg}"
                                HeightRequest="48">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Entry Text="{Binding ConfirmNewPassword}"
                                   IsPassword="True"
                                   Placeholder="Re-enter new password"
                                   PlaceholderColor="{StaticResource Gray400}"
                                   Keyboard="Plain"
                                   ReturnType="Done"
                                   IsEnabled="{Binding IsNotBusy}"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="14"
                                   Margin="12,0"/>
                        </Border>

                        <Button Text="Reset Password"
                                Command="{Binding ResetPasswordCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                BackgroundColor="{StaticResource TealPrimary}"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="16"
                                HeightRequest="50"
                                CornerRadius="10"
                                Margin="0,18,0,0"/>
                    </VerticalStackLayout>

                    <!-- ====== BACK TO LOGIN FOOTER ====== -->
                    <Label Text="Back to Sign In"
                           Margin="0,22,0,0"
                           FontSize="14"
                           TextColor="{StaticResource TealPrimary}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToLoginCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>