<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DigiPasal.ViewModels"
             xmlns:services="clr-namespace:DigiPasal.Services"
             x:Class="DigiPasal.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings"
             BackgroundColor="{StaticResource AppBackground}"
             Shell.TabBarIsVisible="False"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" BackgroundColor="{StaticResource AppBackground}">

<!-- ====== HEADER ====== -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto"
                  Padding="16,52,16,12"
                  BackgroundColor="{StaticResource TealPrimary}">

                <Grid Grid.Column="0"
                      ColumnDefinitions="Auto,Auto"
                      ColumnSpacing="6"
                      VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </Grid.GestureRecognizers>

                    <Label Text="◀"
                           FontSize="20"
                           TextColor="White"
                           VerticalOptions="Center"/>

                    <Label Text="⚙️"
                           Grid.Column="1"
                           FontSize="22"
                           TextColor="White"
                           VerticalOptions="Center"/>
                </Grid>

                <Label Grid.Column="1"
                       Text="Settings"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center"/>

                <Button Grid.Column="2"
                        Text="Refresh"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource SecondaryGold}"
                        FontSize="13"
                        FontAttributes="Bold"
                        Padding="4"
                        VerticalOptions="Center"/>
            </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="14">

                <!-- ====== SHOP IDENTITY CARD ====== -->
                <Border BackgroundColor="{StaticResource TealPrimary}"
                        StrokeThickness="0"
                        Padding="16,18">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,3" Radius="8" Opacity="0.10"/>
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"
                          RowDefinitions="Auto,Auto">
                        <Border Grid.Row="0" Grid.Column="0"
                                Grid.RowSpan="2"
                                WidthRequest="48" HeightRequest="48"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="#33FFFFFF">
                            <Label Text="⚙️" FontSize="22" HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="3">
                            <Label Text="{Binding ShopName}" FontSize="18" FontAttributes="Bold"
                                   TextColor="White" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding ShopAddress}" FontSize="12"
                                   TextColor="#DDE8E7" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- ====== SHOP ====== -->
                <Label Text="SHOP" FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource TealPrimary}" Margin="4,6,0,0" />

                <Border BackgroundColor="{StaticResource CardBackground}" StrokeThickness="0"
                        Padding="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>

                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="ShopSettings_Tapped"/>
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource MoneyTeal}">
                            <Label Text="🏪" FontSize="16" HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Shop Settings" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="Name, address, currency, tax, low stock" FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="20"
                               TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- ====== REPORTS ====== -->
                <Label Text="REPORTS" FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource TealPrimary}" Margin="4,10,0,0" />

                <Border BackgroundColor="{StaticResource CardBackground}" StrokeThickness="0"
                        Padding="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">

                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="SalesReport_Tapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{StaticResource SaleBlue}">
                                <Label Text="📄" FontSize="16" HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Sales Report" FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Daily sales, cash &amp; credit" FontSize="12"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                   TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                            <BoxView Grid.Column="0" Grid.ColumnSpan="3" HeightRequest="1"
                                     Color="{StaticResource DividerColor}"
                                     VerticalOptions="End" Margin="14,0" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="StockReport_Tapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{StaticResource BuyOrange}">
                                <Label Text="📦" FontSize="16" HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Stock Report" FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Quantity, value &amp; low stock" FontSize="12"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                   TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                            <BoxView Grid.Column="0" Grid.ColumnSpan="3" HeightRequest="1"
                                     Color="{StaticResource DividerColor}"
                                     VerticalOptions="End" Margin="14,0" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ProfitReport_Tapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{StaticResource MoneyGreen}">
                                <Label Text="📈" FontSize="16" HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Profit Report" FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Revenue vs estimated COGS" FontSize="12"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                   TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                            <BoxView Grid.Column="0" Grid.ColumnSpan="3" HeightRequest="1"
                                     Color="{StaticResource DividerColor}"
                                     VerticalOptions="End" Margin="14,0" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="CreditReport_Tapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{StaticResource MoneyTeal}">
                                <Label Text="📊" FontSize="16" HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Credit Report" FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Aging, summary &amp; payments" FontSize="12"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                   TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                            <BoxView Grid.Column="0" Grid.ColumnSpan="3" HeightRequest="1"
                                     Color="{StaticResource DividerColor}"
                                     VerticalOptions="End" Margin="14,0" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Reports_Tapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{StaticResource TealLight}">
                                <Label Text="🗂" FontSize="16" HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="All Reports" FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Open the reports hub" FontSize="12"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                   TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ====== BOOKKEEPING ====== -->
                <Label Text="BOOKKEEPING" FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource TealPrimary}" Margin="4,10,0,0" />

                <Border BackgroundColor="{StaticResource CardBackground}" StrokeThickness="0"
                        Padding="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">

                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="12"
                              IsVisible="{Binding CanReopenBook}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ReopenBook_Tapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{StaticResource BuyOrange}">
                                <Label Text="🧾" FontSize="16" HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Reopen Daily Book" FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding ReopenBookHint}" FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                   TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                            <BoxView Grid.Column="0" Grid.ColumnSpan="3" HeightRequest="1"
                                     Color="{StaticResource DividerColor}"
                                     VerticalOptions="End" Margin="14,0" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="BookLog_Tapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{StaticResource MoneyTeal}">
                                <Label Text="📒" FontSize="16" HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Book Open / Close Log" FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Who closed or reopened the daily book, and when" FontSize="12"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                   TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ====== IMPORT DATA ====== -->
                <Label Text="IMPORT DATA" FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource TealPrimary}" Margin="4,10,0,0" />

                <Border BackgroundColor="{StaticResource CardBackground}" StrokeThickness="0"
                        Padding="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">

                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ImportPartners_Tapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{StaticResource SaleBlue}">
                                <Label Text="👥" FontSize="16" HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Import Partners" FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Customers &amp; credit limits from Excel/CSV" FontSize="12"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                   TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                            <BoxView Grid.Column="0" Grid.ColumnSpan="3" HeightRequest="1"
                                     Color="{StaticResource DividerColor}"
                                     VerticalOptions="End" Margin="14,0" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ImportInventory_Tapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{StaticResource BuyOrange}">
                                <Label Text="📦" FontSize="16" HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Import Inventory" FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Products, stock &amp; prices from Excel/CSV" FontSize="12"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                   TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                            <BoxView Grid.Column="0" Grid.ColumnSpan="3" HeightRequest="1"
                                     Color="{StaticResource DividerColor}"
                                     VerticalOptions="End" Margin="14,0" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ImportSales_Tapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{StaticResource MoneyGreen}">
                                <Label Text="🛒" FontSize="16" HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Import Sales" FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Past cash &amp; credit sales from Excel/CSV" FontSize="12"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                   TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                            <BoxView Grid.Column="0" Grid.ColumnSpan="3" HeightRequest="1"
                                     Color="{StaticResource DividerColor}"
                                     VerticalOptions="End" Margin="14,0" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="WholesaleBill_Tapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{StaticResource TealLight}">
                                <Label Text="🧾" FontSize="16" HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Wholesaler Bill Entry" FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Stock in via supplier bills" FontSize="12"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                   TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ====== DATA & BACKUP ====== -->
                <Label Text="DATA &amp; BACKUP" FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource TealPrimary}" Margin="4,10,0,0" />

                <Border BackgroundColor="{StaticResource CardBackground}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">

                        <Label Text="Backup"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"/>

                        <Label Text="Keeps up to 3 automatic copies of your shop data. Always make a backup before resting or updating the app."
                               FontSize="13"
                               TextColor="{StaticResource TextSecondary}"/>

                        <Border BackgroundColor="{StaticResource TealLight}"
                                StrokeShape="RoundRectangle 16"
                                Padding="12,8"
                                HorizontalOptions="Start">
                            <Label Text="{Binding LastBackupTime}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TealPrimary}"/>
                        </Border>

                        <Button Text="Create Backup Now"
                                Command="{Binding BackupNowCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                BackgroundColor="{StaticResource TealPrimary}"
                                TextColor="White"
                                FontSize="15"
                                FontAttributes="Bold"
                                HeightRequest="48"
                                CornerRadius="10"/>

                        <Label Text="{Binding StatusMessage}"
                               IsVisible="{Binding HasStatusMessage}"
                               TextColor="{StaticResource SuccessGreen}"
                               FontSize="13"
                               HorizontalTextAlignment="Center"/>

                        <Label Text="{Binding ErrorMessage}"
                               IsVisible="{Binding HasError}"
                               TextColor="{StaticResource ErrorRed}"
                               FontSize="13"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource TealPrimary}"/>

                <!-- ====== AVAILABLE BACKUPS ====== -->
                <Border BackgroundColor="{StaticResource CardBackground}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Available Backups"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"/>

                        <Label Text="No backups found."
                               IsVisible="{Binding HasNoBackups}"
                               FontSize="13"
                               TextColor="{StaticResource TextSecondary}"/>

                        <CollectionView ItemsSource="{Binding Backups}"
                                        SelectionMode="None"
                                        MaximumHeightRequest="240">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="services:BackupInfo">
                                    <Grid ColumnDefinitions="*,Auto"
                                          RowDefinitions="Auto,Auto"
                                          RowSpacing="2"
                                          Padding="0,8"
                                          ColumnSpacing="12">

                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding FileName}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"/>

                                        <Label Grid.Row="1" Grid.Column="0"
                                               Text="{Binding CreatedAtDisplay}"
                                               FontSize="12"
                                               TextColor="{StaticResource TextSecondary}"/>

                                        <Label Grid.Row="1" Grid.Column="1"
                                               Text="{Binding SizeDisplay}"
                                               FontSize="12"
                                               TextColor="{StaticResource TealPrimary}"
                                               VerticalOptions="Center"
                                               HorizontalOptions="End"/>

                                        <Button Grid.Row="0" Grid.Column="1"
                                                Grid.RowSpan="2"
                                                Text="Restore"
                                                BackgroundColor="{StaticResource InputBg}"
                                                TextColor="{StaticResource DangerRed}"
                                                FontSize="13"
                                                FontAttributes="Bold"
                                                HeightRequest="34"
                                                Padding="12,0"
                                                CornerRadius="8"
                                                BorderColor="{StaticResource DangerRed}"
                                                BorderWidth="1"
                                                VerticalOptions="Center"
                                                Clicked="OnRestoreClicked"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- ====== ACCOUNT ====== -->
                <Label Text="ACCOUNT" FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource TealPrimary}" Margin="4,10,0,0" />

                <Border BackgroundColor="{StaticResource CardBackground}" StrokeThickness="0"
                        Padding="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="0">

                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Profile_Tapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{StaticResource SaleBlue}">
                                <Label Text="👤" FontSize="16" HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Profile" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                   TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                            <BoxView Grid.Column="0" Grid.ColumnSpan="3" HeightRequest="1"
                                     Color="{StaticResource DividerColor}"
                                     VerticalOptions="End" Margin="14,0" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,12" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ChangePassword_Tapped"/>
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="38" HeightRequest="38"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{StaticResource BuyOrange}">
                                <Label Text="🔑" FontSize="16" HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="Change Password" FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                   TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ====== ABOUT ====== -->
                <Label Text="ABOUT" FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource TealPrimary}" Margin="4,10,0,0" />

                <Border BackgroundColor="{StaticResource CardBackground}" StrokeThickness="0"
                        Padding="14">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0" WidthRequest="44" HeightRequest="44"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource TealPrimary}">
                            <Label Text="🛒" FontSize="18" HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="DigiPasal" FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="Your shop, your account books." FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" Padding="10,5" VerticalOptions="Center"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource InputBg}"
                                Stroke="{StaticResource DividerColor}"
                                StrokeThickness="1">
                            <Label Text="v1.2 · © 2026" FontSize="11" FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" />
                        </Border>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>