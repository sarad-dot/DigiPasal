<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DigiPasal.ViewModels"
             xmlns:models="clr-namespace:DigiPasal.Models"
             x:Class="DigiPasal.Views.CartPage"
             Title="Cart"
             Shell.TabBarIsVisible="False"
             x:DataType="vm:CartViewModel"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid RowDefinitions="*,Auto" RowSpacing="0">

        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding CartItems}"
                        SelectionMode="None"
                        BackgroundColor="{StaticResource AppBackground}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="0,60" HorizontalOptions="Center" Spacing="12">
                    <Label Text="Cart is empty" FontSize="18" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" TextColor="{StaticResource TextSecondary}" />
                    <Label Text="Go to Sale tab to add products."
                           FontSize="14" HorizontalTextAlignment="Center"
                           TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.Header>
                <VerticalStackLayout Padding="16,12" Spacing="8">
                    <Label Text="Cart Items" FontSize="18" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CartLine">
                    <Border Padding="14,12" Margin="8,4"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource CardBackground}">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,1" Radius="6" Opacity="0.05"/>
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding ProductName}" FontSize="15" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding UnitPrice, StringFormat='रु {0:N2} each'}"
                                       FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <Button Text="-" WidthRequest="34" HeightRequest="34"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}, Path=DecrementQuantityCommand}"
                                        CommandParameter="{Binding .}"
                                        FontAttributes="Bold" FontSize="16"
                                        BackgroundColor="{StaticResource TealLight}"
                                        TextColor="{StaticResource TealPrimary}"
                                        CornerRadius="8" Padding="0" />
                                <Label Text="{Binding QuantityDisplay}" FontSize="16" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalTextAlignment="Center" WidthRequest="40" HorizontalTextAlignment="Center" />
                                <Button Text="+" WidthRequest="34" HeightRequest="34"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}, Path=IncrementQuantityCommand}"
                                        CommandParameter="{Binding .}"
                                        FontAttributes="Bold" FontSize="16"
                                        BackgroundColor="{StaticResource TealLight}"
                                        TextColor="{StaticResource TealPrimary}"
                                        CornerRadius="8" Padding="0" />
                            </HorizontalStackLayout>
                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding LineTotalDisplay}" FontSize="15" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       HorizontalTextAlignment="End" />
                                <Button Text="Remove" FontSize="11"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CartViewModel}}, Path=RemoveItemCommand}"
                                        CommandParameter="{Binding .}"
                                        TextColor="{StaticResource ErrorRed}" BackgroundColor="Transparent"
                                        Padding="0" HeightRequest="24" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom Checkout Panel -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource CardBackground}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16,16,0,0"
                Padding="16,14">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-2" Radius="12" Opacity="0.08"/>
            </Border.Shadow>
            <VerticalStackLayout Spacing="10">

                <!-- Customer Selection -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Border Grid.Column="0" Stroke="{StaticResource InputStroke}" StrokeThickness="1"
                            BackgroundColor="{StaticResource InputBg}" HeightRequest="42">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding SelectedCustomerDisplay}"
                               FontSize="13" VerticalTextAlignment="Center"
                               TextColor="{StaticResource TextSecondary}" Margin="12,0"
                               LineBreakMode="TailTruncation" />
                    </Border>
                    <Button Grid.Column="1" Text="Select"
                            Command="{Binding SelectCustomerCommand}"
                            BackgroundColor="{StaticResource TealLight}"
                            TextColor="{StaticResource TealPrimary}"
                            FontSize="12" HeightRequest="42" CornerRadius="10" />
                </Grid>

                <!-- Credit Toggle -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="Credit Sale" FontSize="14"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalTextAlignment="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding IsCreditSale}"
                            IsEnabled="{Binding HasCustomer}"
                            ThumbColor="{StaticResource TealPrimary}" />
                </Grid>

                <!-- Amount Paid (visible for credit) -->
                <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsCreditSale}">
                    <Label Text="Amount Paid:" FontSize="14" VerticalTextAlignment="Center"
                           TextColor="{StaticResource TextPrimary}" />
                    <Border Stroke="{StaticResource InputStroke}" StrokeThickness="1"
                            BackgroundColor="{StaticResource InputBg}" HeightRequest="40"
                            WidthRequest="120" HorizontalOptions="End">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Entry Text="{Binding AmountPaid}" Placeholder="0.00"
                               Keyboard="Numeric"
                               BackgroundColor="Transparent"
                               TextColor="{StaticResource TextPrimary}"
                               PlaceholderColor="{StaticResource Gray400}"
                               FontSize="14" />
                    </Border>
                </HorizontalStackLayout>

                <!-- Notes -->
                <Border Stroke="{StaticResource InputStroke}" StrokeThickness="1"
                        BackgroundColor="{StaticResource InputBg}" HeightRequest="42">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding Notes}" Placeholder="Sale notes (optional)"
                           FontSize="13" MaxLength="200"
                           BackgroundColor="Transparent"
                           TextColor="{StaticResource TextPrimary}"
                           PlaceholderColor="{StaticResource Gray400}"
                           Margin="12,0" />
                </Border>

                <!-- Totals -->
                <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" Margin="0,4" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Subtotal" FontSize="14"
                           TextColor="{StaticResource TextSecondary}" />
                    <Label Grid.Column="1" Text="{Binding SubtotalDisplay}" FontSize="14"
                           TextColor="{StaticResource TextPrimary}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" IsVisible="False">
                    <Label Grid.Column="0" Text="Discount" FontSize="14"
                           TextColor="{StaticResource TextSecondary}" />
                    <Label Grid.Column="1" Text="{Binding DiscountDisplay}" FontSize="14"
                           TextColor="{StaticResource ErrorRed}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="TOTAL" FontSize="18" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                    <Label Grid.Column="1" Text="{Binding GrandTotalDisplay}" FontSize="18" FontAttributes="Bold"
                           TextColor="{StaticResource TealPrimary}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsCreditSale}">
                    <Label Grid.Column="0" Text="Due" FontSize="14"
                           TextColor="{StaticResource ErrorRed}" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="{Binding CreditDisplay}" FontSize="14"
                           TextColor="{StaticResource ErrorRed}" FontAttributes="Bold" />
                </Grid>

                <!-- Checkout Button -->
                <Button Text="Complete Sale"
                        Command="{Binding CheckoutCommand}"
                        BackgroundColor="{StaticResource TealPrimary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        HeightRequest="50"
                        CornerRadius="12"
                        Margin="0,4,0,0" />
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
