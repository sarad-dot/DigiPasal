<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DigiPasal.ViewModels"
             xmlns:models="clr-namespace:DigiPasal.Models"
             x:Class="DigiPasal.Views.SaleDetailPage"
             Title="Sale Detail"
             Shell.TabBarIsVisible="False"
             x:DataType="vm:SaleDetailViewModel">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="{Binding Sale.ReceiptNumber}" FontSize="18" FontAttributes="Bold" />
                    <Label Text="{Binding Sale.CreatedAt, StringFormat='{0:dd MMMM yyyy, HH:mm}'}"
                           FontSize="13" TextColor="{StaticResource Gray500}" />
                </VerticalStackLayout>
                <Border Grid.Column="1" Padding="10,6"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource Primary}">
                    <Label Text="{Binding StatusBadge}" TextColor="White" FontSize="13" FontAttributes="Bold" />
                </Border>
            </Grid>

            <!-- Customer Info -->
            <Border Padding="14"
                    StrokeShape="RoundRectangle 8"
                    Stroke="{StaticResource Gray200}"
                    IsVisible="{Binding IsCreditSale}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Customer" FontSize="12" TextColor="{StaticResource Gray500}" />
                    <Label Text="{Binding Sale.CustomerName}" FontSize="15" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <!-- Items Table -->
            <Border Padding="12"
                    StrokeShape="RoundRectangle 8"
                    Stroke="{StaticResource Gray200}">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" Padding="4,6" ColumnSpacing="8">
                        <Label Text="Item" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray500}" />
                        <Label Grid.Column="1" Text="Qty" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray500}" />
                        <Label Grid.Column="2" Text="Rate" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray500}" />
                        <Label Grid.Column="3" Text="Total" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray500}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,4" />
                    <CollectionView ItemsSource="{Binding Items}" SelectionMode="None" HeightRequest="200">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:SaleItem">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" Padding="4,6" ColumnSpacing="8">
                                    <Label Text="{Binding ProductName}" FontSize="13" LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1" Text="{Binding Quantity}" FontSize="13" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="2" Text="{Binding UnitPrice, StringFormat='रु {0:N2}'}" FontSize="13" HorizontalTextAlignment="End" />
                                    <Label Grid.Column="3" Text="{Binding LineTotal, StringFormat='रु {0:N2}'}" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Totals -->
            <Border Padding="14"
                    StrokeShape="RoundRectangle 8"
                    Stroke="{StaticResource Gray200}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Subtotal" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Label Grid.Column="1" Text="{Binding Sale.Subtotal, StringFormat='रु {0:N2}'}" FontSize="14" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Sale.DiscountAmount}">
                        <Label Text="Discount" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Label Grid.Column="1" Text="{Binding Sale.DiscountAmount, StringFormat='-रु {0:N2}'}" FontSize="14" TextColor="Red" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Sale.TaxAmount}">
                        <Label Text="Tax" FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Label Grid.Column="1" Text="{Binding Sale.TaxAmount, StringFormat='रु {0:N2}'}" FontSize="14" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Gray300}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Grand Total" FontSize="18" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding TotalDisplay}" FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Notes -->
            <Border Padding="14"
                    StrokeShape="RoundRectangle 8"
                    Stroke="{StaticResource Gray200}"
                    IsVisible="False">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Notes" FontSize="12" TextColor="{StaticResource Gray500}" />
                    <Label Text="{Binding Sale.Notes}" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <!-- Actions -->
            <VerticalStackLayout Spacing="10" Margin="0,0,0,24">
                <Button Text="Share Receipt"
                        Command="{Binding ShareReceiptCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="48" />
                <Button Text="Void Sale"
                        Command="{Binding VoidSaleCommand}"
                        BackgroundColor="Red"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="48" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
