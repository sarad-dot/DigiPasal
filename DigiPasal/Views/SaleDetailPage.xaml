<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DigiPasal.ViewModels"
             xmlns:models="clr-namespace:DigiPasal.Models"
             x:Class="DigiPasal.Views.SaleDetailPage"
             Title="Sale Detail"
             Shell.TabBarIsVisible="False"
             x:DataType="vm:SaleDetailViewModel"
             BackgroundColor="{StaticResource AppBackground}">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">

            <!-- Header -->
            <Border Padding="16"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource CardBackground}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.06"/>
                </Border.Shadow>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="{Binding Sale.ReceiptNumber}" FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Text="{Binding Sale.CreatedAt, StringFormat='{0:dd MMMM yyyy, HH:mm}'}"
                               FontSize="13" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" Padding="12,6"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource TealPrimary}">
                        <Label Text="{Binding StatusBadge}" TextColor="White" FontSize="13" FontAttributes="Bold" />
                    </Border>
                </Grid>
            </Border>

            <!-- Customer Info -->
            <Border Padding="16"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource CardBackground}"
                    IsVisible="{Binding IsCreditSale}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,1" Radius="6" Opacity="0.05"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Customer" FontSize="12"
                           TextColor="{StaticResource TextSecondary}" />
                    <Label Text="{Binding Sale.CustomerName}" FontSize="15" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" />
                </VerticalStackLayout>
            </Border>

            <!-- Items Table -->
            <Border Padding="14"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource CardBackground}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,1" Radius="6" Opacity="0.05"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" Padding="4,6" ColumnSpacing="8">
                        <Label Text="Item" FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Column="1" Text="Qty" FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Column="2" Text="Rate" FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Column="3" Text="Total" FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" Margin="0,4" />
                    <CollectionView ItemsSource="{Binding Items}" SelectionMode="None" HeightRequest="200">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:SaleItem">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" Padding="4,8" ColumnSpacing="8">
                                    <Label Text="{Binding ProductName}" FontSize="13"
                                           TextColor="{StaticResource TextPrimary}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1" Text="{Binding Quantity}" FontSize="13"
                                           TextColor="{StaticResource TextPrimary}"
                                           HorizontalTextAlignment="End" />
                                    <Label Grid.Column="2" Text="{Binding UnitPrice, StringFormat='रु {0:N2}'}" FontSize="13"
                                           TextColor="{StaticResource TextPrimary}"
                                           HorizontalTextAlignment="End" />
                                    <Label Grid.Column="3" Text="{Binding LineTotal, StringFormat='रु {0:N2}'}" FontSize="13"
                                           FontAttributes="Bold" TextColor="{StaticResource TealPrimary}"
                                           HorizontalTextAlignment="End" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Totals -->
            <Border Padding="16"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource CardBackground}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,1" Radius="6" Opacity="0.05"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Subtotal" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Column="1" Text="{Binding Sale.Subtotal, StringFormat='रु {0:N2}'}" FontSize="14"
                               TextColor="{StaticResource TextPrimary}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Sale.DiscountAmount}">
                        <Label Text="Discount" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Column="1" Text="{Binding Sale.DiscountAmount, StringFormat='-रु {0:N2}'}" FontSize="14"
                               TextColor="{StaticResource ErrorRed}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Sale.TaxAmount}">
                        <Label Text="Tax" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                        <Label Grid.Column="1" Text="{Binding Sale.TaxAmount, StringFormat='रु {0:N2}'}" FontSize="14"
                               TextColor="{StaticResource TextPrimary}" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource DividerColor}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Grand Total" FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Grid.Column="1" Text="{Binding TotalDisplay}" FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource TealPrimary}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Notes -->
            <Border Padding="16"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource CardBackground}"
                    IsVisible="False">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,1" Radius="6" Opacity="0.05"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Notes" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    <Label Text="{Binding Sale.Notes}" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                </VerticalStackLayout>
            </Border>

            <!-- Actions -->
            <VerticalStackLayout Spacing="10" Margin="0,0,0,24">
                <Button Text="Share Receipt"
                        Command="{Binding ShareReceiptCommand}"
                        BackgroundColor="{StaticResource TealPrimary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        CornerRadius="12" />
                <Button Text="Void Sale"
                        Command="{Binding VoidSaleCommand}"
                        BackgroundColor="{StaticResource ErrorRed}"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        CornerRadius="12" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
