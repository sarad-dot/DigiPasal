<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DigiPasal.ViewModels"
             xmlns:svc="clr-namespace:DigiPasal.Services"
             x:Class="DigiPasal.Views.DayBookLogPage"
             x:DataType="vm:DayBookLogViewModel"
             Title="Book Log"
             Shell.TabBarIsVisible="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid RowDefinitions="Auto,*" BackgroundColor="{StaticResource AppBackground}">

        <!-- ══════════ HEADER ══════════ -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto"
              Padding="16,52,16,12" BackgroundColor="{StaticResource TealPrimary}">
            <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto" ColumnSpacing="6"
                  VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped"/>
                </Grid.GestureRecognizers>
                <Label Text="◀" FontSize="20" TextColor="White" VerticalOptions="Center"/>
                <Label Text="📒" Grid.Column="1" FontSize="20" TextColor="White"
                       VerticalOptions="Center"/>
            </Grid>
            <Label Grid.Column="1" Text="Book Open / Close Log" FontSize="20" FontAttributes="Bold"
                   TextColor="White" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
            <Label Grid.Column="2" Text="" FontSize="12" TextColor="White"/>
        </Grid>

        <!-- ══════════ BODY ══════════ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="10">

                <Label Text="Global history, newest first. Every close or reopen of the daily book is recorded here with the user who performed it."
                       FontSize="12" TextColor="{StaticResource TextSecondary}"/>

                <VerticalStackLayout Spacing="10">
                    <BindableLayout.ItemsSource>
                        <Binding Path="Logs"/>
                    </BindableLayout.ItemsSource>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="svc:DayBookLogRow">
                            <Border BackgroundColor="{StaticResource CardBackground}" StrokeThickness="0"
                                    Padding="12,10">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0"
                                          BackgroundColor="{StaticResource TealPrimary}"
                                          WidthRequest="34" HeightRequest="34"
                                          StrokeShape="RoundRectangle 17"
                                          HorizontalOptions="Center" VerticalOptions="Start">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsOpened}" Value="False">
                                                <Setter Property="BackgroundColor" Value="{StaticResource ErrorRed}"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Grid>
                                            <Label Text="▲" IsVisible="{Binding IsOpened}" FontSize="16"
                                                   TextColor="White" HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                            <Label Text="●" FontSize="16" TextColor="White"
                                                   HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsOpened}" Value="True">
                                                        <Setter Property="IsVisible" Value="False"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Grid>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding ActionLabel}" FontSize="14" FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"/>
                                        <Label Text="{Binding BookDateFullDisplay}" FontSize="12"
                                               TextColor="{StaticResource TextSecondary}"/>
                                        <Label Text="{Binding Note}" FontSize="12"
                                               TextColor="{StaticResource TextSecondary}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Note}" Value="">
                                                    <Setter Property="IsVisible" Value="False"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="2"
                                                         HorizontalOptions="End">
                                        <Label Text="{Binding TimeDisplay}" FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"
                                               HorizontalTextAlignment="End"/>
                                        <Label Text="{Binding TimestampDisplay}" FontSize="10"
                                               TextColor="{StaticResource Gray400}"
                                               HorizontalTextAlignment="End"
                                               MaxLines="2" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding UserName}" FontSize="11"
                                               TextColor="{StaticResource TealPrimary}"
                                               HorizontalTextAlignment="End"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="{Binding Footer}" FontSize="12"
                       TextColor="{StaticResource Gray400}"
                       HorizontalTextAlignment="Center" Margin="0,8,0,20"/>
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           Color="{StaticResource TealPrimary}"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
    </Grid>
</ContentPage>